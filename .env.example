# local keeps task mail/calendar synthetic; a key enables image and transcription calls.
APP_MODE=local
TRUST_ID=uclh
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Independent fast synthetic example generation; no journal context.
OPENAI_EXAMPLE_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Optional exact private HTTPS host and a long random access-link secret.
PUBLIC_DEMO_HOST=
DEMO_ACCESS_TOKEN=
# Optional verified Tailscale Serve login; requires loopback and --no-proxy-headers.
TAILSCALE_ALLOWED_LOGIN=
DATABASE_URL=
GOOGLE_TOKEN_FILE=data/google-token.json
GOOGLE_CLIENT_FILE=data/google-client.json
# Throwaway accounts only. Exact allowlist; NHS domains always refused.
TEST_UCLH_EMAIL=uclh@example.test
TEST_EMPLOYER_EMAIL=manager@example.test
TEST_INBOX_EMAIL=
CONFIRM_THROWAWAY_ACCOUNTS=false
